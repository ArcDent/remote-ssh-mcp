{
  "name": "@arcdent/remote-ssh-mcp",
  "version": "0.2.0",
  "description": "按 ~/.ssh/config 里的主机别名在远程主机上执行常用运维命令的 MCP 服务",
  "type": "module",
  "license": "MIT",
  "bin": {
    "remote-ssh-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "call": "node scripts/call.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcDent/remote-ssh-mcp.git"
  }
}
